{
  "name": "statement-tools",
  "version": "1.0.0",
  "description": "Upload bank statements, parse via YFW AI, get merged CSV",
  "author": "YourFinanceWORKS",
  "license": "AGPLv3",
  "license_tier": "agpl",
  "mode": "sidecar",
  "service_name": "plugin_statement_tools",
  "api_prefix": "/api/v1/statement-tools",
  "ui_entry": "/plugins/statement-tools/",
  "database_tables": [],
  "permitted_core_tables": [
    "users",
    "batch_processing_jobs",
    "batch_file_processing",
    "export_destination_configs",
    "ai_configs"
  ],
  "nav_items": [
    {
      "id": "statement-tools",
      "path": "/statement-tools",
      "label": "Statement Tools",
      "icon": "FileSpreadsheet",
      "priority": 5
    }
  ],
  "api_routes": [
    {
      "path": "/api/v1/statement-tools/statements/upload",
      "methods": ["POST"],
      "description": "Upload multiple bank statements (PDF/CSV) for AI parsing"
    },
    {
      "path": "/api/v1/statement-tools/statements/download/{token}",
      "methods": ["GET"],
      "description": "Download merged statement CSV — public endpoint, no auth required"
    },
    {
      "path": "/api/v1/statement-tools/batch/upload",
      "methods": ["POST"],
      "description": "Upload files for async batch processing"
    },
    {
      "path": "/api/v1/statement-tools/batch/jobs/{job_id}",
      "methods": ["GET"],
      "description": "Poll batch job status"
    },
    {
      "path": "/api/v1/statement-tools/batch/jobs/{job_id}/csv",
      "methods": ["GET"],
      "description": "Download a completed job's transactions as CSV"
    },
    {
      "path": "/api/v1/statement-tools/batch/merge-csv",
      "methods": ["POST"],
      "description": "Merge transactions from multiple completed jobs into a single CSV"
    }
  ],
  "features": ["upload_portal", "batch-processing", "job-history"],
  "public_page": {
    "path": "/p/statement-tools",
    "label": "Statement Portal",
    "ui_entry": "/plugins/statement-tools/"
  }
}
