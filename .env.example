# ── YourFinanceWORKS connection (standalone mode only) ─────────────────────────
# URL of the YFW instance this tool connects to for AI statement processing
YFW_API_URL=http://localhost:8000

# API key from YFW: Settings → API Access → Create Key
# (requires the "external_api" license feature)
YFW_API_KEY=ak_your_key_here

# ── This service's own API protection (standalone mode) ────────────────────────
# Leave blank to allow open access (useful for local dev / trusted networks).
# Set to a long random string in production.
STATEMENT_TOOLS_API_KEY=

# ── Sidecar mode (plugin inside YFW) ──────────────────────────────────────────
# Shared JWT secret — must match the main YFW app's SECRET_KEY.
# When set, JWT validation is used instead of STATEMENT_TOOLS_API_KEY.
YFW_SECRET_KEY=

# ── Download link expiry ───────────────────────────────────────────────────────
DOWNLOAD_EXPIRY_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to "*" (all).
# CORS_ORIGINS=http://localhost:5173,https://your-app.com
